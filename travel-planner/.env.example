# Anthropic API 密钥:不配置时服务运行在「演示模式」(mock 数据 + 确定性建议)
ANTHROPIC_API_KEY=

# 模型路由(可选;默认分别为轻量与标准档,可自行调整以权衡成本/质量)
PLANNER_PARSE_MODEL=claude-haiku-4-5
PLANNER_PLAN_MODEL=claude-sonnet-5

# 大模型供应商(anthropic 默认 / openai 兼容如 DeepSeek)
# openai 时:base_url 默认 https://api.deepseek.com,模型默认 deepseek-chat;实时网页检索不可用
PLANNER_PROVIDER=anthropic
# OpenAI 兼容供应商的 API 地址(仅 provider=openai 时生效;默认 https://api.deepseek.com)
# OPENAI_BASE_URL=
# Anthropic 供应商的自定义端点(走网关/代理时设置;provider=anthropic 时生效)
# ANTHROPIC_BASE_URL=

# 途牛适配器(本期为占位:TUNIU_ENABLED=1 会尝试,但缺 TUNIU_API_KEY 自动回落 mock)
TUNIU_API_KEY=
TUNIU_ENABLED=0

# SQLite 价格快照路径
PLANNER_DB_PATH=data/travel.db

# 多平台景点交叉(POI):至少配 1~2 个 key 才有真实交叉;一个不配则回落内置演示景点
AMAP_KEY=
TENCENT_MAP_KEY=
BAIDU_MAP_KEY=
# 启用哪些 POI 平台(逗号分隔;缺 key 的平台会被跳过)
POI_PROVIDERS=amap,tencent,baidu

# 实时网页资讯检索(Claude 网页搜索):默认关;置 1 开启,或用 API 的 web_research=true 单次开启
WEB_RESEARCH_ENABLED=0

# 运行期模型配置持久化路径(页面保存的 Key/模型等;默认在数据目录下,已 gitignore)
# MODEL_CONFIG_PATH=data/model_config.json

